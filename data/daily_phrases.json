        {"fr": "Où est l'hôpital le plus proche ?", "en": "Where is the nearest hospital?"},
        {"fr": "J'ai besoin d'un médecin.", "en": "I need a doctor."},
        {"fr": "Je ne me sens pas bien.", "en": "I don't feel well."},
        {"fr": "J'ai mal à la tête / au ventre.", "en": "I have a headache / stomachache."},
        {"fr": "Appelez la police !", "en": "Call the police!"},
        {"fr": "J'ai perdu mon passeport.", "en": "I lost my passport."},
        {"fr": "C'est une urgence.", "en": "It's an emergency."}
      ]
    },
    {
      "id": "small_talk",
      "title": "Small Talk & Social",
      "phrases": [
        {"fr": "Quel temps fait-il ?", "en": "What's the weather like?"},
        {"fr": "Il fait beau aujourd'hui.", "en": "The weather is nice today."},
        {"fr": "D'où venez-vous ?", "en": "Where are you from?"},
        {"fr": "Je viens de Turquie.", "en": "I'm from Turkey."},
        {"fr": "Qu'est-ce que vous faites dans la vie ?", "en": "What do you do for a living?"},
        {"fr": "C'était un plaisir de parler avec vous.", "en": "It was a pleasure talking with you."},
        {"fr": "On reste en contact.", "en": "Let's stay in touch."},
        {"fr": "Bonne chance !", "en": "Good luck!"}
      ]
    },
    {
      "id": "phone_internet",
      "title": "Phone, Internet & Technology",
      "phrases": [
        {"fr": "Quel est le mot de passe du wifi ?", "en": "What's the wifi password?"},
        {"fr": "Je n'ai pas de réseau.", "en": "I have no signal."},
        {"fr": "Pouvez-vous m'appeler plus tard ?", "en": "Can you call me later?"},
        {"fr": "Je vous envoie un message.", "en": "I'll send you a message."},
        {"fr": "Mon téléphone est déchargé.", "en": "My phone's battery is dead."},
        {"fr": "Pouvez-vous répéter, s'il vous plaît ?", "en": "Can you repeat, please?"},
        {"fr": "Je ne comprends pas.", "en": "I don't understand."},
        {"fr": "Pouvez-vous parler plus lentement ?", "en": "Can you speak more slowly?"}
