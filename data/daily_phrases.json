      "title": "Greetings & Introductions",
      "phrases": [
        {"fr": "Bonjour !", "en": "Hello! / Good morning!", "note": "Standard greeting until evening."},
        {"fr": "Bonsoir !", "en": "Good evening!"},
        {"fr": "Salut !", "en": "Hi! / Bye!", "note": "Informal, used with friends."},
        {"fr": "Comment allez-vous ?", "en": "How are you? (formal)"},
        {"fr": "Comment ça va ?", "en": "How's it going? (informal)"},
        {"fr": "Je m'appelle...", "en": "My name is..."},
        {"fr": "Enchanté(e).", "en": "Nice to meet you."},
        {"fr": "Au revoir !", "en": "Goodbye!"},
        {"fr": "À bientôt !", "en": "See you soon!"},
        {"fr": "À demain !", "en": "See you tomorrow!"}
      ]
    },
    {
      "id": "politeness",
      "title": "Politeness & Courtesy",
      "phrases": [
        {"fr": "S'il vous plaît.", "en": "Please. (formal/plural)"},
        {"fr": "S'il te plaît.", "en": "Please. (informal)"},
        {"fr": "Merci beaucoup.", "en": "Thank you very much."},
        {"fr": "Je vous en prie.", "en": "You're welcome. (formal)"},
        {"fr": "De rien.", "en": "You're welcome. (casual)"},
        {"fr": "Excusez-moi.", "en": "Excuse me. (formal)"},
        {"fr": "Pardon.", "en": "Sorry / Excuse me."},
        {"fr": "Je suis désolé(e).", "en": "I'm sorry."},
        {"fr": "Pas de problème.", "en": "No problem."},
        {"fr": "Avec plaisir.", "en": "With pleasure / Gladly."}
      ]
    },
    {
      "id": "shopping",
      "title": "Shopping",
      "phrases": [
        {"fr": "Combien ça coûte ?", "en": "How much does it cost?"},
        {"fr": "C'est combien ?", "en": "How much is it?"},
        {"fr": "Je cherche...", "en": "I'm looking for..."},
        {"fr": "Est-ce que vous avez...?", "en": "Do you have...?"},
        {"fr": "Je voudrais acheter ceci.", "en": "I would like to buy this."},
        {"fr": "C'est trop cher.", "en": "It's too expensive."},
        {"fr": "Vous acceptez la carte ?", "en": "Do you accept card?"},
        {"fr": "Où est la caisse ?", "en": "Where is the checkout?"},
        {"fr": "Avez-vous une taille plus petite/grande ?", "en": "Do you have a smaller/bigger size?"},
        {"fr": "Je prends ça.", "en": "I'll take this."}
      ]
    },
    {
      "id": "dining",
      "title": "Restaurants & Dining",
      "phrases": [
        {"fr": "Une table pour deux, s'il vous plaît.", "en": "A table for two, please."},
        {"fr": "Je voudrais commander.", "en": "I would like to order."},
        {"fr": "Qu'est-ce que vous recommandez ?", "en": "What do you recommend?"},
        {"fr": "L'addition, s'il vous plaît.", "en": "The bill, please."},
        {"fr": "C'était délicieux.", "en": "It was delicious."},
        {"fr": "Je suis végétarien(ne).", "en": "I am vegetarian."},
        {"fr": "Je suis allergique aux noix.", "en": "I am allergic to nuts."},
        {"fr": "Un verre d'eau, s'il vous plaît.", "en": "A glass of water, please."},
        {"fr": "C'est pour emporter.", "en": "It's to take away."},
        {"fr": "Bon appétit !", "en": "Enjoy your meal!"}
      ]
    },
    {
      "id": "directions",
      "title": "Asking for Directions",
      "phrases": [
        {"fr": "Où est la gare ?", "en": "Where is the train station?"},
        {"fr": "Comment je peux aller à...?", "en": "How can I get to...?"},
        {"fr": "C'est loin d'ici ?", "en": "Is it far from here?"},
        {"fr": "Tournez à gauche / à droite.", "en": "Turn left / right."},
        {"fr": "Allez tout droit.", "en": "Go straight ahead."},
        {"fr": "C'est à côté de...", "en": "It's next to..."},
        {"fr": "Je suis perdu(e).", "en": "I am lost."},
        {"fr": "Pouvez-vous me montrer sur le plan ?", "en": "Can you show me on the map?"},
        {"fr": "À quelle distance se trouve...?", "en": "How far is...?"},
        {"fr": "Au coin de la rue.", "en": "At the corner of the street."}
      ]
    },
    {
      "id": "transport",
      "title": "Transportation",
      "phrases": [
        {"fr": "Un billet pour Paris, s'il vous plaît.", "en": "A ticket to Paris, please."},
        {"fr": "À quelle heure part le train ?", "en": "What time does the train leave?"},
        {"fr": "Je voudrais réserver un taxi.", "en": "I would like to book a taxi."},
        {"fr": "Le bus est en retard.", "en": "The bus is late."},
        {"fr": "Où puis-je louer une voiture ?", "en": "Where can I rent a car?"},
        {"fr": "C'est quel quai ?", "en": "Which platform is it?"},
        {"fr": "Je dois descendre où ?", "en": "Where do I need to get off?"},
        {"fr": "Un aller-retour, s'il vous plaît.", "en": "A round trip, please."}
      ]
    },
    {
      "id": "time_dates",
      "title": "Time & Dates",
      "phrases": [
        {"fr": "Quelle heure est-il ?", "en": "What time is it?"},
        {"fr": "Il est trois heures.", "en": "It's three o'clock."},
        {"fr": "Quel jour sommes-nous ?", "en": "What day is it?"},
        {"fr": "Nous sommes le 23 octobre.", "en": "It's October 23rd."},
        {"fr": "À quelle heure commence...?", "en": "What time does... start?"},
        {"fr": "Aujourd'hui / Demain / Hier.", "en": "Today / Tomorrow / Yesterday."},
        {"fr": "La semaine prochaine.", "en": "Next week."},
        {"fr": "Je suis en retard.", "en": "I am late."}
      ]
    },
    {
      "id": "emergencies",
      "title": "Emergencies & Health",
      "phrases": [
        {"fr": "Au secours !", "en": "Help!"},
