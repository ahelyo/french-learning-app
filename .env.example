# Ollama (gemma4:31b-cloud runs on Ollama's cloud, proxied transparently via the local
# `ollama serve` daemon -- no local model weights are downloaded)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Whisper (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Edge-TTS
TTS_VOICE=fr-FR-DeniseNeural

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
